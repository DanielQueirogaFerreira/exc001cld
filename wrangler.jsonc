{
  // EXC001CLD — recursos estáticos servidos da raiz do repositório.
  //
  // "run_worker_first" manda /api/* diretamente para o código, antes de o
  // Cloudflare procurar ficheiros. Todo o resto continua estático, servido
  // pela borda e não faturado.
  //
  // "not_found_handling": "none" deixa qualquer caminho sem ficheiro cair no
  // Worker, em vez de devolver uma página de erro em HTML — foi isso que
  // partia as chamadas de API.
  "name": "exc001cld",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "colmeia",
      "database_id": "1b7ad7f8-0f2c-406b-80cf-d4f095702660"
    }
  ]
}
